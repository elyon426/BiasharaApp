{
  "expo": {
    "name": "Biashara Sacco",
    "slug": "BiasharaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/download.png",
    "scheme": "biasharaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/aa83d81e-9b60-4292-bd16-a5e1b1090e38",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/download.png",
      "bundleIdentifier": "com.biashara.app"
    },
    "android": {
      "package": "com.biashara.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptiveIconBaPP.png",
        "backgroundColor": "#2d6a2d"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/download.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/download.png",
            "backgroundColor": "#1a1a1a"
          }
        }
      ]
    ],
    "experiments": {
  "typedRoutes": true,
  "reactCompiler": false
},
    "extra": {
      "eas": {
        "projectId": "aa83d81e-9b60-4292-bd16-a5e1b1090e38"
      }
    },
    "owner": "elyon001"
  }
}